# Provider API keys (only needed for providers you want to run)
RESUME_BENCH_LLAMA_CLOUD_API_KEY=
RESUME_BENCH_REDUCTO_API_KEY=
RESUME_BENCH_OPENAI_API_KEY=
RESUME_BENCH_ANTHROPIC_API_KEY=
RESUME_BENCH_GOOGLE_API_KEY=

# Careerflow provider (optional)
RESUME_BENCH_CAREERFLOW_API_KEY=
RESUME_BENCH_CAREERFLOW_API_URL=

# Benchmark settings
RESUME_BENCH_DATA_DIR=~/.cache/resume-bench
RESUME_BENCH_OUTPUT_DIR=./output
RESUME_BENCH_CONCURRENCY=4
RESUME_BENCH_RETRIES=2
